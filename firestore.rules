rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return request.auth != null && getUserData().role == 'admin';
    }
    
    function isWorker() {
      return request.auth != null && getUserData().role == 'worker';
    }
    
    function isCustomer() {
      return request.auth != null && getUserData().role == 'customer';
    }

    // Users collection
    match /users/{userId} {
      // Anyone logged in can read (needed for order assignment references)
      allow read: if request.auth != null; 
      // Users can edit own profile, admins can edit anyone
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin()); 
    }

    // Designs collection (Our Designs store)
    match /designs/{designId} {
      // Publicly readable
      allow read: if true;
      // Only admins can modify
      allow write: if isAdmin();
    }

    // Carts collection
    match /carts/{userId} {
      // Users can only read/write their own cart
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Orders collection
    match /orders/{orderId} {
      // Users can create orders
      allow create: if request.auth != null;
      // Admins & workers can read all, customers can read own
      allow read: if request.auth != null && (isAdmin() || isWorker() || resource.data.customerId == request.auth.uid);
      // Admins & workers can update all, customers can update own
      allow update: if request.auth != null && (isAdmin() || isWorker() || resource.data.customerId == request.auth.uid);
      // Only admins can delete
      allow delete: if isAdmin();
    }

  }
}
