rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return request.auth != null && getUserData().role == 'admin';
    }
    
    function isWorker() {
      return request.auth != null && getUserData().role == 'worker';
    }
    
    function isCustomer() {
      return request.auth != null && getUserData().role == 'customer';
    }

    // Users collection
    match /users/{userId} {
      // Anyone logged in can read (needed for order assignment references)
      allow read: if request.auth != null; 
      // Users can edit own profile, admins can edit anyone
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin()); 
    }

    // Designs collection (Our Designs store)
    match /designs/{designId} {
      // Publicly readable
      allow read: if true;
      // Only admins can modify
      allow write: if isAdmin();
    }

    // Carts collection (subcollection: cart/{userId}/items/{itemId})
    match /cart/{userId}/items/{itemId} {
      // Users can only read/write their own cart items
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Orders collection
    match /orders/{orderId} {
      // Users can create orders
      allow create: if request.auth != null;
      // Admins & workers can read all, customers can read own
      allow read: if request.auth != null && (isAdmin() || isWorker() || resource.data.customerId == request.auth.uid);
      // Admins & workers can update all fields
      allow update: if request.auth != null && (isAdmin() || isWorker());
      // Customers can only update their own order's shipping address
      allow update: if request.auth != null
        && resource.data.customerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shippingAddress', 'updatedAt']);
      // Only admins can delete
      allow delete: if isAdmin();
    }

    // Counters collection
    match /counters/{counterId} {
      allow read, update: if request.auth != null;
      allow create: if isAdmin();
    }

    // Settings collection
    match /settings/{settingId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Materials collection
    match /materials/{materialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Printers collection
    match /printers/{printerId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Categories collection
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

  }
}
